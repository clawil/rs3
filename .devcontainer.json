// Development container for rs3. See https://containers.dev
//
// Replaces a docker-compose setup built on the fastai/codespaces image, whose
// three services are all obsolete: `jekyll` served documentation that Quarto now
// builds, `watcher` ran nbdev_build_docs (a nbdev v1 command name), and
// `notebook` duplicated what the container itself provides.
{
    "name": "rs3",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",

    "features": {
        // nbdev builds the docs with Quarto; this keeps `nbdev-preview` working,
        // which is what the old jekyll service was for.
        "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {}
    },

    // 8888 is JupyterLab, 4200 is quarto preview.
    "forwardPorts": [8888, 4200],

    "postCreateCommand": "pip install -e '.[dev]' && nbdev-install-hooks",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "quarto.quarto"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python"
            }
        }
    }
}
